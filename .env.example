# ==============================================================================
# Ambiente de desenvolvimento local (HTTP permitido apenas em localhost/127.0.0.1)
# Em producao/HTTPS, defina ALLOW_LOCAL_HTTP=false e use URLs https://
# ==============================================================================
ALLOW_LOCAL_HTTP=true

# ------------------------------------------------------------------------------
# Aplicacao Cliente (Relying Party) — porta padrao 8000
# ------------------------------------------------------------------------------
OIDC_ISSUER=http://localhost:8001
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8001/authorize
OIDC_CLIENT_ID=app-cybersecurity-33506
OIDC_CLIENT_SECRET=DEFINA_UM_CLIENT_SECRET_ALEATORIO_NO_SEU_ENV_LOCAL
OIDC_REDIRECT_URI=http://localhost:8000/callback
OIDC_HTTP_TIMEOUT=5
OIDC_CLOCK_SKEW_SECONDS=60

# ------------------------------------------------------------------------------
# Servidor de Autorizacao (OpenID Provider) — porta padrao 8001
# ------------------------------------------------------------------------------
AUTH_SERVER_ISSUER=http://localhost:8001
AUTH_SERVER_CODE_TTL=60
AUTH_SERVER_TOKEN_TTL=900
AUTH_SERVER_REFRESH_TTL=86400
AUTH_SERVER_RATE_LIMIT_MAX=5
AUTH_SERVER_RATE_LIMIT_WINDOW=300

# ------------------------------------------------------------------------------
# Script de seed (definir senhas locais no .env — nunca versionar senhas reais)
# ------------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_PARA_ADMIN
SEED_USER_USERNAME=usuario
SEED_USER_PASSWORD=DEFINA_UMA_SENHA_FORTE_PARA_USER
